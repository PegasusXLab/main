# Real values go in your local .env (gitignored) and in Vercel's environment
# variables. Never put real values here, in the repo, or in any Docs-branch
# message.

# Vultr Object Storage (S3-compatible) -- ADR-008. Unset locally: falls back
# to local disk storage under .data/ (gitignored).
VULTR_S3_ENDPOINT=
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
