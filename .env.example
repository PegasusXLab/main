# Real values go in your local .env (gitignored) and in Vercel's environment
# variables. Never put real values here, in the repo, or in any Docs-branch
# message.

# Vultr Object Storage (S3-compatible) -- ADR-008. Unset locally: falls back
# to local disk storage under .data/ (gitignored).
VULTR_S3_ENDPOINT=
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=

# Accounts (ADR-014): HMAC secret for the gv_session cookie, a random string of
# 32+ bytes (e.g. `openssl rand -base64 48`). Unset in development: a dev-only
# fallback is used. Unset in production: /api/auth/* answers 503.
AUTH_SECRET=

# Email verification (T-147): Gmail SMTP with an app password (Google account →
# Security → App passwords). Unset outside production: codes print to the server
# console. Unset in production: sign-up answers 503.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Test hook (T-147): requests with header `x-e2e-verify-secret` equal to this
# (24+ chars) get the verification code back, so e2e sign-ups can finish.
# Leave unset unless you run the live e2e suite.
E2E_VERIFY_SECRET=
